SITE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-45XWR4KJ1M
# Passer à true après désactivation vérifiée de la mesure améliorée et contrôle du flux GA4.
NEXT_PUBLIC_GA4_READY=false
SITE_DATA_MODE=mock
SITE_ADMIN_SECRET=
SITE_ADMIN_USERS=[]
DATABASE_URL=
GITHUB_TOKEN=
CRON_SECRET=
# Skills.sh via Vercel OIDC; active OIDC Federation on the Vercel project is required.
VERCEL_OIDC_TOKEN=
# Optional Hub auth token for higher Hugging Face API limits.
HUGGINGFACE_TOKEN=
# Alias accepté par le collecteur Models (même rôle que HUGGINGFACE_TOKEN).
HF_TOKEN=
# Enables OpenRouter popularity, throughput, context, price and Artificial Analysis signals.
OPENROUTER_API_KEY=
# Facultatif pour l'import des épisodes : la page publique fournit la date et la durée.
# Nécessaire pour les statistiques de chaîne du tableau de bord social.
YOUTUBE_API_KEY=
# Lecture des insights Instagram (compte professionnel) ; jeton conservé côté serveur.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=v25.0
# OAuth TikTok avec user.info.stats et video.list.
TIKTOK_ACCESS_TOKEN=
# Facultatif : page d'inscription publique de la newsletter, en HTTPS.
CHARTS_NEWSLETTER_URL=
# Vide : les calculs v3 restent en brouillon. Renseigner les versions exactes après revue.
CHARTS_REVIEWED_PROFILE_VERSIONS=
# Activer après migration 0009 et validation des quotas/coûts. Collecte horaire bornée.
CHARTS_BURST_COLLECTION_ENABLED=false
GITHUB_BURST_POOL_SIZE=200
# Facultatif : JSON validé par burstPolicySchema. Les seuils initiaux sont dans le domaine.
GITHUB_BURST_POLICY_JSON=
# Source HTML fragile, réservée à la découverte et désactivée avant revue des conditions.
GITHUB_TRENDING_DISCOVERY_ENABLED=false
