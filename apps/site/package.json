{
  "name": "@podcast/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:news": "node scripts/news-local.mjs",
    "news:translator:setup": "node scripts/news-translation-setup.mjs",
    "news:translator:check": "node --experimental-strip-types scripts/news-translation-smoke.mjs",
    "news:summarizer:setup": "node scripts/news-summary-setup.mjs",
    "news:automation:refresh": "node --experimental-strip-types scripts/news-refresh.ts",
    "dev:time-machine": "node scripts/time-machine-local.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "content:check": "node scripts/content-check.ts",
    "sitemap:check": "node scripts/check-sitemap.ts",
    "test:public-routes": "node scripts/test-public-routes.mjs",
    "test:og:tracing": "node scripts/test-og-tracing.mjs",
    "test:analytics:e2e": "node scripts/test-analytics-e2e.mjs",
    "test:news:e2e": "node scripts/test-news-e2e.mjs",
    "test:admin:http": "node scripts/test-admin-security-production.mjs",
    "content:new": "node scripts/content-new.ts",
    "week:run": "node scripts/week-run.ts",
    "charts:discover": "node --env-file-if-exists=.env.local scripts/charts.ts discover",
    "charts:collect": "node --env-file-if-exists=.env.local scripts/charts.ts collect",
    "charts:weekly": "node --env-file-if-exists=.env.local scripts/charts.ts weekly",
    "charts:external-collect": "node --env-file-if-exists=.env.local scripts/charts.ts external-collect",
    "charts:external-weekly": "node --env-file-if-exists=.env.local scripts/charts.ts external-weekly",
    "charts:seed": "node --env-file-if-exists=.env.local scripts/charts.ts seed",
    "badges:awards": "node --env-file-if-exists=.env.local scripts/badges.ts",
    "dev:badges": "node scripts/badges-local.mjs",
    "dev:fronts": "node scripts/fronts-local.mjs",
    "test:fronts": "node scripts/test-fronts.mjs",
    "test:fronts:interactions": "node scripts/test-front-interactions.mjs",
    "test:badges:e2e": "node scripts/test-badges-e2e.mjs",
    "test:badges:http": "node scripts/test-badges-production.mjs",
    "charts:bursts": "node --env-file-if-exists=.env.local scripts/charts.ts bursts",
    "charts:trending": "node --env-file-if-exists=.env.local scripts/charts.ts trending",
    "charts:reference": "node scripts/reference-ranking.ts",
    "charts:identities": "node --env-file-if-exists=.env.local scripts/models-identities.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:seed": "node scripts/db-seed.ts",
    "admin:bootstrap": "node scripts/admin-bootstrap.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.6.1",
    "@vercel/speed-insights": "2.0.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "playwright": "1.62.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3"
  }
}
